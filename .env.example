# Local deployment configuration template.
#
# Copy this file to `.env` on the machine that runs the project, then fill in
# real values there. Do not commit `.env` to GitHub.

# Camera network settings
CAMERA_HOST=192.168.1.xxx
CAMERA_SNAPSHOT_URL=http://192.168.1.xxx/cgi-bin/snapshot.sh?res=high&watermark=yes
CAMERA_RTSP_URL=rtsp://192.168.1.xxx/ch0_0.h264

# WiFi credentials for setup notes or deployment scripts.
# Keep these local only.
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password

# MQTT settings for yi-hack-MStar motion events.
MQTT_ENABLED=false
MQTT_HOST=192.168.1.xxx
MQTT_PORT=1883
MQTT_CLIENT_ID=yi-cam
MQTT_USERNAME=
MQTT_PASSWORD=

# Hamlib / rotctld settings
HAMLIB_HOST=127.0.0.1
HAMLIB_PORT=4533
HAMLIB_MODEL=1
HAMLIB_SERIAL_DEVICE_WINDOWS=COM7
HAMLIB_SERIAL_DEVICE_LINUX=/dev/ttyUSB0
HAMLIB_SERIAL_SPEED=115200

# SDR / rigctl settings
RIGCTL_HOST=127.0.0.1
RIGCTL_PORT=4532

# Safety and capture behavior
DEFAULT_CENTER_AZ=180.0
DEFAULT_CENTER_EL=167.5
SAFE_WINDOW_DEGREES=20.0
CAPTURE_INTERVAL_SECONDS=5.0
